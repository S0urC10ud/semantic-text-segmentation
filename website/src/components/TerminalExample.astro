---
import { Image } from 'astro:assets';
import terminal from '../assets/typeseg-terminal.png';
const fullImage = `${import.meta.env.BASE_URL}images/typeseg-example.png`;
---
<figure class="terminal-example">
  <a href={fullImage} aria-label="Open the terminal example at full size">
    <Image src={terminal} width={1000} format="webp" quality={95} loading="lazy"
      alt="Terminal output showing colored CSS, JavaScript, HTML, SQL, and shell regions, with a table of character ranges and confidence." />
  </a>
  <figcaption>Recorded Mamba output from <a href="https://pypi.org/project/typeseg/">TypeSeg on PyPI</a>. The historical screenshot’s banner reads <code>textseg.precise</code>; the current API call is <code>typeseg.precise</code>. Colors mark content types; the table shows ranges and confidence. Shell command text is redacted.</figcaption>
</figure>
