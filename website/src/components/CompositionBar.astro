---
const regions = [
  { label: 'Python', start: 0, end: 2048, color: '#3976c5', detail: 'The surrounding script.' },
  { label: 'PowerShell', start: 2048, end: 3072, color: '#8655c9', detail: 'An embedded script region to inspect with a PowerShell analyzer.' },
  { label: 'Base64', start: 3072, end: 4608, color: '#b84f87', detail: 'An encoded region to pass to a decoder before further inspection.' },
  { label: 'Python', start: 4608, end: 6144, color: '#3976c5', detail: 'The surrounding script continues.' },
];
---
<figure class="composition-example">
  <div class="composition-heading"><strong>One file. Several content types.</strong><span>Illustrative ASCII file · 6,144 bytes</span></div>
  <div class="composition-track" aria-label="File composition, in byte order">
    {regions.map(region => <button type="button" class="composition-region"
      style={`--region-color:${region.color};flex-grow:${region.end - region.start}`}
      data-detail={`${region.label} · bytes ${region.start.toLocaleString('en-US')}–${region.end.toLocaleString('en-US')} · ${(region.end-region.start).toLocaleString('en-US')} bytes. ${region.detail}`}
      aria-label={`${region.label}, bytes ${region.start} to ${region.end}, ${region.end - region.start} bytes`}
      title={`${region.label}: ${region.end - region.start} bytes`}>
      <span>{region.label}</span>
    </button>)}
  </div>
  <div class="composition-axis"><span>0</span><span>3,072</span><span>6,144 bytes</span></div>
  <p class="composition-detail" aria-live="polite">Select a region to see its location and size.</p>
  <figcaption>A composition view for a sample-details page, such as VirusTotal’s. Colors mark contiguous regions; widths show their sizes. This is an illustration, not a VirusTotal integration or a model prediction.</figcaption>
</figure>
<script>
  document.querySelectorAll('.composition-example').forEach(example => {
    const detail = example.querySelector('.composition-detail');
    example.querySelectorAll<HTMLButtonElement>('.composition-region').forEach(button => {
      const show = () => { if (detail) detail.textContent = button.dataset.detail || ''; };
      button.addEventListener('click', show);
      button.addEventListener('focus', show);
      button.addEventListener('mouseenter', show);
    });
  });
</script>
