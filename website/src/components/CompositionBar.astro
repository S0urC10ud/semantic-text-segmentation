---
import { regions, sampleText, totalBytes, buildSourceLines } from '../lib/composition-example.mjs';
const lines = buildSourceLines(sampleText, regions);
const format = (value: number) => value.toLocaleString('en-US');
const labelColor = (hex: string) => {
  const rgb = hex.slice(1).match(/../g)!.map(channel => {
    const value = parseInt(channel, 16) / 255;
    return value <= .04045 ? value / 12.92 : ((value + .055) / 1.055) ** 2.4;
  });
  const luminance = rgb[0] * .2126 + rgb[1] * .7152 + rgb[2] * .0722;
  return (luminance + .05) / .0556 > 1.05 / (luminance + .05) ? '#111111' : '#ffffff';
};
---
<figure class="composition-example" data-default-region={regions.findIndex(region => region.label === 'Shell')}>
  <div class="composition-heading"><strong>One file. Several content types.</strong><span>Illustrative ASCII file · {format(totalBytes)} bytes</span></div>
  <div class="composition-track" aria-label="File composition, in byte order">
    {regions.map((region, index) => <button type="button" class="composition-region"
      style={`--region-color:${region.color};--region-ink:${labelColor(region.color)};flex-grow:${region.end - region.start}`}
      data-region={index}
      data-detail={`${region.label} · bytes ${format(region.start)}–${format(region.end)} · ${format(region.end-region.start)} bytes. ${region.detail}`}
      aria-controls="composition-source-preview" aria-expanded="false"
      aria-label={`${region.label}, bytes ${region.start} to ${region.end}, ${region.end - region.start} bytes`}>
      <span>{(region.end - region.start) / totalBytes >= .08 ? region.label : ''}</span>
    </button>)}
  </div>
  <div class="composition-axis"><span>0</span><span>{format(Math.floor(totalBytes / 2))}</span><span>{format(totalBytes)} bytes</span></div>
  <div class="composition-toolbar">
    <p class="composition-detail" aria-live="polite">Hover to unfold the file. Select a region to inspect its text.</p>
    <button class="composition-toggle" type="button" aria-expanded="false" aria-controls="composition-source-preview">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M3 9h18M9 9v12"/></svg>
      <span>Inspect source</span>
    </button>
  </div>
  <div id="composition-source-preview" class="composition-source" aria-hidden="true" inert>
    <div class="composition-source-inner">
      <div class="composition-source-heading"><strong>Inside the file</strong><span>Same bytes, unfolded into lines</span></div>
      <pre class="composition-code" aria-label="Illustrative source text, marked by content type"><code>{lines.map(line => <span class="composition-code-line"><span class="composition-line-number" aria-hidden="true">{line.number}</span><span class="composition-line-text">{line.parts.length ? line.parts.map(part => <span class="composition-code-region" data-region={part.regionIndex} style={`--region-color:${part.color}`}>{part.text}</span>) : ' '}</span></span>)}</code></pre>
      <div class="composition-legend">
        {[...new Map(regions.map(r => [r.label, r])).values()].map(region => <span><i style={`background:${region.color}`}></i>{region.label}</span>)}
      </div>
    </div>
  </div>
  <figcaption>Hover across the bar to follow the highlighted text. Byte ranges match this source exactly; labels are illustrative.</figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('.composition-example').forEach(example => {
    const detail = example.querySelector('.composition-detail');
    const preview = example.querySelector<HTMLElement>('.composition-source');
    const toggle = example.querySelector<HTMLButtonElement>('.composition-toggle');
    const buttons = example.querySelectorAll<HTMLButtonElement>('.composition-region');
    const defaultButton = buttons[Number(example.dataset.defaultRegion)] || buttons[0];
    let pinned = false;
    let hovered = false;
    if (!preview || !toggle) return;

    const open = (value: boolean) => {
      example.classList.toggle('is-expanded', value);
      preview.inert = !value;
      preview.setAttribute('aria-hidden', String(!value));
      toggle.setAttribute('aria-expanded', String(value));
      const caption = toggle.querySelector('span');
      if (caption) caption.textContent = value ? 'Close source' : 'Inspect source';
      buttons.forEach(button => button.setAttribute('aria-expanded', String(value)));
    };
    const select = (button: HTMLButtonElement) => {
      if (detail) detail.textContent = button.dataset.detail || '';
      example.querySelectorAll<HTMLElement>('.composition-code-region, .composition-region').forEach(piece => {
        piece.classList.toggle('is-active', piece.dataset.region === button.dataset.region);
      });
      example.classList.add('has-selection');
      open(true);
    };
    example.addEventListener('pointerenter', event => {
      if (event.pointerType !== 'mouse') return;
      hovered = true;
      if (!example.classList.contains('has-selection')) select(defaultButton);
      open(true);
    });
    example.addEventListener('pointerleave', () => {
      hovered = false;
      if (!pinned && !example.contains(document.activeElement)) open(false);
    });
    example.addEventListener('focusout', event => {
      if (!example.contains(event.relatedTarget as Node | null) && !hovered && !pinned) open(false);
    });
    example.addEventListener('keydown', event => {
      if (event.key !== 'Escape') return;
      pinned = false;
      hovered = false;
      open(false);
      toggle.focus({ preventScroll: true });
    });
    buttons.forEach(button => {
      button.addEventListener('mouseenter', () => select(button));
      button.addEventListener('focus', () => select(button));
      button.addEventListener('click', () => { pinned = true; select(button); });
    });
    toggle.addEventListener('click', () => {
      const next = !example.classList.contains('is-expanded');
      pinned = next;
      if (!next) hovered = false;
      if (next && !example.classList.contains('has-selection')) select(defaultButton);
      open(next);
    });
  });
</script>
